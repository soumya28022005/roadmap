{
  "name": "roadmap",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:gen": "cd packages/db && pnpm gen && cd ..",
    "db:migrate": "cd packages/db && pnpm migrate && cd ..",
    "db:deploy": "cd packages/db && pnpm migrate:deploy && cd ..",
    "db:studio": "cd packages/db && pnpm studio && cd ..",
    "db:reset": "cd packages/db && pnpm reset && cd .."
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3"
  }
}
