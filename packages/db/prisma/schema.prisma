generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  phoneNumber   String         @unique
  email         String         @unique
  passwordHash  String
  
  reports       Report[]
  confirmations Confirmation[]
  rides         Ride[]         // 👈 ADD THIS LINE

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Report {
  id            String         @id @default(uuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  latitude      Float
  longitude     Float
  type          HazardType
  description   String?
  confidence    Float          @default(1.0)
  
  confirmations Confirmation[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([latitude, longitude])
  @@index([userId]) // User-specific queries fast korar jonno
  @@map("reports")
}

model Confirmation {
  id        String   @id @default(uuid())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  isTrue    Boolean
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportId, userId])
  @@index([reportId]) 
  @@map("confirmations")
}

enum HazardType {
  POTHOLE
  SINGLE_SPEED_BUMP
  MULTIPLE_SPEED_BUMP
  ROAD_PATCH
}

model Ride {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  originLat   Float
  originLng   Float
  destLat     Float
  destLng     Float
  vehicleType String
  status      RideStatus @default(IN_PROGRESS)
  
  startTime   DateTime   @default(now())
  endTime     DateTime?  // Optional: gets filled when the ride ends

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@map("rides")
}

enum RideStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}